# Model protocol:
# openai = Chat Completions compatible
# anthropic = Messages compatible
AI_PROTOCOL=openai

# Optional in Snowflake App Runtime.
# If omitted there, the adapter derives the account host from SNOWFLAKE_HOST.
#
# Cortex REST:
# AI_TARGET=cortex
#
# Cortex AI Gateway:
# AI_TARGET=gateway
AI_TARGET=cortex

# Override the base URL when running outside App Runtime, when using another
# provider, or when Snowflake returns a custom/private gateway host.
#
# Cortex REST example:
# AI_BASE_URL=https://<account>.snowflakecomputing.com/api/v2/cortex/v1
#
# AI Gateway example:
# AI_BASE_URL=https://<account-host>/api/v2/aigateways/SNOWFLAKE/v1
AI_BASE_URL=

AI_MODEL=

# Optional in Snowflake App Runtime. The app automatically reads the rotating
# OAuth token from /snowflake/session/token on every AI request.
# Set this for local development or another compatible provider.
AI_API_KEY=

# Snowflake REST / AI Gateway uses Bearer.
# Set x-api-key for providers that use the native Anthropic header.
AI_AUTH_MODE=bearer

AI_ANTHROPIC_VERSION=2023-06-01

# Optional local-only transport using the official Codex App Server and the
# existing `codex login` authentication. No API key is read by this application.
# AI_RUNTIME=codex
# AI_MODEL=gpt-6-luna
# AI_REASONING_EFFORT=medium
# AI_TIMEOUT_MS=120000
# API transport is the default; deployment to Snowflake uses the settings above.


# Persistence backend. SQLite is the default prototype backend.
# Future implementations can satisfy BusinessFlowRepository and be registered
# in lib/storage/index.ts (for example Snowflake Hybrid Tables).
BUSINESS_FLOW_STORAGE=sqlite
BUSINESS_FLOW_SQLITE_PATH=.data/business-flow-lens.sqlite

# Used as revision updater outside Snowflake App Runtime.
# In App Runtime, the request's current-user context is preferred.
BUSINESS_FLOW_LOCAL_USER=local-user

# Optional server-side Word/PowerPoint page renderer. An existing LibreOffice
# installation is found at the standard Windows path, or via `soffice` on PATH.
# Set an absolute path for a portable/local installation.
BFL_OFFICE_RENDERER=
