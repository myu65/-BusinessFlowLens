# Protocol shape used by the upstream model endpoint.
# openai = Chat Completions compatible
# anthropic = Messages compatible
AI_PROTOCOL=openai

# Examples:
# Snowflake Cortex REST (OpenAI-compatible)
# AI_BASE_URL=https://<account>.snowflakecomputing.com/api/v2/cortex/v1
#
# Snowflake Cortex AI Gateway (OpenAI-compatible)
# AI_BASE_URL=https://<account-host>/api/v2/aigateways/SNOWFLAKE/v1
#
# For Anthropic-compatible Messages, use a base path immediately before
# /messages. The adapter appends /messages automatically.
AI_BASE_URL=

AI_MODEL=
AI_API_KEY=

# Snowflake REST / AI Gateway uses Bearer.
# Set x-api-key for providers that use the native Anthropic header.
AI_AUTH_MODE=bearer

# Optional override for Anthropic-compatible endpoints.
AI_ANTHROPIC_VERSION=2023-06-01
